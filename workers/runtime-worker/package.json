{
  "name": "@uicodeanalysis/runtime-worker",
  "version": "0.1.0",
  "private": true,
  "description": "运行时采集 Worker：Playwright 被动采集组件树与网络请求 → RuntimeTrace",
  "type": "module",
  "bin": {
    "runtime-worker": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
