{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    // 测试只由 vitest 运行（vite/esbuild 转译），模块解析是 bundler 语义；
    // 与 ast-worker 的 tsconfig.test.json 同理。
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
