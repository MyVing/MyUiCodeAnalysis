{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uicodeanalysis.local/schemas/specdoc.schema.json",
  "title": "SpecDocMap",
  "description": "规格文档装配产物：基于一次需求定位（RequirementMap）与 IR 图，确定性装配 + 模型推断生成「业务操作步骤 + 前端交互视图」的结构化数据。确定性条目（elements / events / apiMappings）source=static，置信度取自 IR 证据；模型推断条目（steps / rules / fieldMappings）source=ai，置信度封顶 0.6，quote 必须逐字命中该页面语料，失败进 dropped。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specDocId",
    "projectId",
    "requirementId",
    "requirement",
    "createdAt",
    "dryRun",
    "pages",
    "steps",
    "elements",
    "events",
    "rules",
    "fieldMappings",
    "apiMappings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "本文件格式版本，与 IR / requirement schema 版本解耦"
    },
    "specDocId": {
      "type": "string",
      "minLength": 1,
      "description": "一次规格装配产物的唯一标识"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "description": "来源需求定位产物（RequirementMap）的 id；同一份定位产物可多次生成规格"
    },
    "analysisId": {
      "type": "string",
      "description": "本次装配所基于的图产物标识。与项目最新图不一致时说明结果已过期（前置校验会直接拒绝，本字段只是留痕）"
    },
    "requirement": {
      "type": "string",
      "minLength": 1,
      "description": "原始需求文本，取自来源定位产物，原样回显"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "dryRun": {
      "type": "boolean",
      "description": "为 true 时只跑确定性装配（elements / events / apiMappings），未调用模型；steps / rules / fieldMappings 必为空，warnings 带 dry_run_skipped_llm_sections"
    },
    "pages": {
      "type": "array",
      "description": "涉及的页面与编号：按来源定位 matches 的出现顺序分配 pageNo（1 起）。章节编号 2.x 的 x 即 pageNo",
      "items": { "$ref": "#/$defs/Page" }
    },
    "steps": {
      "type": "array",
      "description": "2.x.3 业务操作步骤。模型推断章节；dryRun 或模型不可用时为空",
      "items": { "$ref": "#/$defs/Step" }
    },
    "elements": {
      "type": "array",
      "description": "2.x.4.1 页面要素清单。确定性装配：三分类（数据要素 / 动作要素 / 展示要素）",
      "items": { "$ref": "#/$defs/Element" }
    },
    "events": {
      "type": "array",
      "description": "2.x.4.2 事件清单。确定性装配：仅含触发后端调用的事件（链路含 api 段）",
      "items": { "$ref": "#/$defs/Event" }
    },
    "rules": {
      "type": "array",
      "description": "2.x.4.3 前端业务规则。模型推断章节，五类：validation / display / linkage / session / permission",
      "items": { "$ref": "#/$defs/Rule" }
    },
    "fieldMappings": {
      "type": "array",
      "description": "2.x.4.4 前后端字段映射。模型推断章节",
      "items": { "$ref": "#/$defs/FieldMapping" }
    },
    "apiMappings": {
      "type": "array",
      "description": "2.x.4.5 前后端接口映射。确定性装配：按 url 去重的动作→接口清单",
      "items": { "$ref": "#/$defs/ApiMapping" }
    },
    "dropped": {
      "type": "array",
      "description": "被服务端校验拒绝的模型输出（quote 校验失败 / 形状非法）。必须展示而非静默丢弃",
      "items": { "$ref": "requirement.schema.json#/$defs/Dropped" }
    },
    "warnings": {
      "type": "array",
      "description": "降级与缺口：链路断点、无匹配页面、模型不可用等",
      "items": { "$ref": "requirement.schema.json#/$defs/RequirementWarning" }
    }
  },
  "$defs": {
    "Page": {
      "title": "Page",
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "pageNo", "name"],
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "description": "页面组件节点 id（IR 中真实存在）"
        },
        "pageNo": {
          "type": "integer",
          "minimum": 1,
          "description": "页面序号，按来源定位 matches 出现顺序分配；章节编号 2.{pageNo}"
        },
        "name": { "type": "string", "minLength": 1 },
        "file": {
          "type": "string",
          "description": "页面组件定义所在文件（相对项目根目录）"
        },
        "routeId": {
          "type": "string",
          "description": "该页面命中的 route 节点 id；无 route 时缺省"
        },
        "featureIds": {
          "type": "array",
          "description": "定位到该页面的功能点 id 列表",
          "items": { "type": "string" }
        }
      }
    },
    "Step": {
      "title": "Step",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "featureId", "actions"],
      "description": "一个功能点的操作步骤组（对应模板 2.x.3 的「前置条件 + 步骤表」）",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "步骤组标识，如 step.f1"
        },
        "featureId": {
          "type": "string",
          "minLength": 1,
          "description": "来源功能点 id（RequirementMap.features 内）"
        },
        "pageId": {
          "type": "string",
          "description": "该功能点定位到的页面节点 id"
        },
        "precondition": {
          "type": "array",
          "description": "前置条件列表",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "description": "操作步骤（有序）；每条形如「选择付款账户，系统展示该账户可用余额」",
          "items": { "type": "string", "minLength": 1 }
        },
        "quote": {
          "type": "string",
          "description": "模型给出的依据原文（已通过服务端逐字校验）"
        },
        "evidence": {
          "type": "array",
          "description": "引文解析到的证据位置",
          "items": { "$ref": "requirement.schema.json#/$defs/VerifiedEvidence" }
        }
      }
    },
    "ElementKind": {
      "title": "ElementKind",
      "type": "string",
      "enum": ["data", "action_remote", "action_local", "display"],
      "description": "要素三分类：data=数据要素（input/select 等录入）；action_remote=动作要素·发请求；action_local=动作要素·本地动作；display=展示要素"
    },
    "Element": {
      "title": "Element",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageId", "kind", "tag", "desc"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "要素标识，如 ui.1.3（1 为页面序号）"
        },
        "pageId": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/ElementKind" },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "元素标签或组件名，如 button / input / Select / text"
        },
        "uiText": {
          "type": ["string", "null"],
          "description": "可见文案；动态文案（input 无 placeholder、纯图标按钮等）时缺省"
        },
        "required": {
          "type": "boolean",
          "description": "数据要素的必填标记（attrs.required）；非数据要素缺省"
        },
        "desc": {
          "type": "string",
          "minLength": 1,
          "description": "说明（placeholder / title / 列名等，缺省给分类描述）"
        },
        "eventIds": {
          "type": "array",
          "description": "该要素触发的事件 id（events 内）",
          "items": { "type": "string" }
        },
        "featureIds": {
          "type": "array",
          "description": "定位到该要素所属链路的功能点 id；无功能点直接命中时缺省",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "description": "要素的证据位置（取自 IR 节点 evidence，source=static）",
          "items": { "$ref": "requirement.schema.json#/$defs/VerifiedEvidence" }
        }
      }
    },
    "HttpCall": {
      "title": "HttpCall",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "Handler": {
      "title": "Handler",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": {
          "type": "string",
          "description": "处理函数定义所在文件（相对项目根目录）"
        },
        "loc": { "$ref": "requirement.schema.json#/$defs/Location" }
      }
    },
    "Event": {
      "title": "Event",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageId", "elementId", "handler", "source", "confidence"],
      "description": "仅收集触发后端调用的事件（链路含 api 段），与模板「事件清单（仅触发后端调用的事件）」一致",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "事件标识，如 evt.1.2"
        },
        "pageId": { "type": "string", "minLength": 1 },
        "elementId": { "type": "string", "minLength": 1 },
        "eventType": {
          "type": "string",
          "description": "事件类型（click / change / submit 等）；元素 attrs.events 里可解析时给出"
        },
        "handler": { "$ref": "#/$defs/Handler" },
        "httpCalls": {
          "type": "array",
          "description": "该事件触发的后端调用（链路 api 段，按出现顺序去重）",
          "items": { "$ref": "#/$defs/HttpCall" }
        },
        "chainId": {
          "type": "string",
          "description": "来源交互链路 id（derive_chains 确定性产出），可回图核对"
        },
        "source": {
          "type": "string",
          "enum": ["static", "runtime", "ai"],
          "description": "恒为 static：事件清单是确定性装配，不调模型"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "取自链路段对应 IR 节点的证据置信度"
        }
      }
    },
    "RuleCategory": {
      "title": "RuleCategory",
      "type": "string",
      "enum": ["validation", "display", "linkage", "session", "permission"],
      "description": "规则五类：validation=交互校验（A）/ display=展示规则（B）/ linkage=联动规则（C）/ session=会话状态（D）/ permission=权限规则（E）"
    },
    "Rule": {
      "title": "Rule",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageId", "category", "condition", "result"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "规则标识，如 fr.1.1"
        },
        "pageId": { "type": "string", "minLength": 1 },
        "featureId": {
          "type": "string",
          "description": "关联功能点 id（模型输出）；缺省表示页面级规则"
        },
        "category": { "$ref": "#/$defs/RuleCategory" },
        "target": {
          "type": "string",
          "description": "作用对象（要素名 / 字段名）"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "description": "条件（Condition）"
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "description": "结果（Action）"
        },
        "quote": {
          "type": "string",
          "description": "模型给出的依据原文（已通过服务端逐字校验）"
        },
        "evidence": {
          "type": "array",
          "description": "引文解析到的证据位置",
          "items": { "$ref": "requirement.schema.json#/$defs/VerifiedEvidence" }
        }
      }
    },
    "FieldMapping": {
      "title": "FieldMapping",
      "type": "object",
      "additionalProperties": false,
      "required": ["frontField", "backendParam", "api"],
      "properties": {
        "frontField": {
          "type": "string",
          "minLength": 1,
          "description": "前端字段名"
        },
        "backendParam": {
          "type": "string",
          "minLength": 1,
          "description": "后端参数名"
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "description": "所属接口（method + url 或 url）"
        },
        "pageId": { "type": "string" },
        "quote": {
          "type": "string",
          "description": "模型给出的依据原文（已通过服务端逐字校验）"
        },
        "evidence": {
          "type": "array",
          "description": "引文解析到的证据位置",
          "items": { "$ref": "requirement.schema.json#/$defs/VerifiedEvidence" }
        }
      }
    },
    "ApiMapping": {
      "title": "ApiMapping",
      "type": "object",
      "additionalProperties": false,
      "required": ["elementId", "method", "url", "source", "confidence"],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1,
          "description": "触发该接口的要素 id（elements 内）"
        },
        "eventId": {
          "type": "string",
          "description": "触发该接口的事件 id（events 内）"
        },
        "actionName": {
          "type": "string",
          "description": "动作名称（要素可见文案，如「转账按钮」）"
        },
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "enum": ["static", "runtime", "ai"],
          "description": "恒为 static：接口映射来自链路 api 段，不调模型"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "取自 api 节点证据置信度；链路直连按 0.95 分档"
        }
      }
    }
  }
}
