{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uicodeanalysis.local/schemas/runtime.schema.json",
  "title": "RuntimeTrace",
  "description": "浏览器运行时采集结果（A 模式）。与静态 IR 分开保存，通过 traceId / analysisId 关联。大体积 DOM、截图与 Trace 只保存 artifact:// 引用，不进 JSON。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "traceId", "projectId", "mode", "page"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "运行时契约版本，独立于 IR schema 版本演进"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "description": "一次采集记录的唯一标识；Evidence.traceId 反查至此"
    },
    "projectId": { "type": "string", "minLength": 1 },
    "analysisId": {
      "type": "string",
      "description": "关联的静态分析产物标识；一次分析可对应多次采集"
    },
    "mode": {
      "type": "string",
      "enum": ["passive", "ai-exploration"],
      "description": "passive：A 模式被动采集；ai-exploration：B 模式 AI 自动探索页面、生成场景与用例"
    },
    "exploration": {
      "$ref": "#/$defs/Exploration",
      "description": "B 模式探索配置与结果；passive 模式缺省"
    },
    "devServer": { "$ref": "#/$defs/DevServer" },
    "componentTree": {
      "type": "array",
      "items": { "$ref": "#/$defs/ComponentNode" },
      "description": "React fiber 树还原的组件挂载树（根组件数组）；file/line 与静态图合并时的关键运行时证据"
    },
    "page": { "$ref": "#/$defs/PageInfo" },
    "domSnapshotRef": {
      "type": "string",
      "pattern": "^artifact://",
      "description": "DOM 快照的 Artifact 引用，形如 artifact://trace_001/dom.json"
    },
    "screenshotRef": {
      "type": "string",
      "pattern": "^artifact://",
      "description": "页面截图的 Artifact 引用"
    },
    "traceRef": {
      "type": "string",
      "pattern": "^artifact://",
      "description": "Playwright Trace 的 Artifact 引用"
    },
    "networkEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/NetworkEvent" }
    },
    "consoleEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/ConsoleEvent" }
    },
    "pageErrors": {
      "type": "array",
      "items": { "$ref": "#/$defs/PageError" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Interaction" }
    },
    "correlations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Correlation" },
      "description": "DOM 元素与静态节点的关联结果；无法关联时保留为 unmatched，不强行挂接"
    }
  },
  "$defs": {
    "DevServer": {
      "title": "DevServer",
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "dev server 实际监听端口（可能与配置值不同，以运行时探测为准）"
        },
        "host": {
          "type": "string",
          "description": "监听地址，缺省 localhost"
        },
        "command": {
          "type": "string",
          "description": "被托管的启动命令，如 npm run dev -w app"
        }
      }
    },
    "ComponentNode": {
      "title": "ComponentNode",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "组件名：displayName > 函数名 > 匿名占位"
        },
        "file": {
          "type": "string",
          "description": "位点文件（相对被采集项目根目录）；来自 _debugSource（定义位点）或 _debugStack（JSX 创建位点），无法定位时缺省"
        },
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 },
        "source": {
          "type": "string",
          "enum": ["debug-source", "debug-stack", "name-only"],
          "description": "定位来源降级链：debug-source（React≤18 _debugSource，组件定义位点 file+line）> debug-stack（React≥19 _debugStack 解析，JSX 创建位点）> name-only（React≥19 _debugTask 无名字可取，仅组件名）"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentNode" }
        }
      }
    },
    "PageInfo": {
      "title": "PageInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1, "description": "页面 URL 或路由路径" },
        "title": { "type": "string" },
        "route": { "type": "string", "description": "匹配到的前端路由模板" },
        "timestamp": { "type": "integer", "minimum": 0, "description": "采集时间，Unix 秒" },
        "viewport": { "$ref": "#/$defs/Viewport" }
      }
    },
    "Viewport": {
      "title": "Viewport",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "NetworkEvent": {
      "title": "NetworkEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "method", "url"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 0 },
        "resourceType": { "type": "string" },
        "initiator": { "type": "string" },
        "durationMs": { "type": "number", "minimum": 0 },
        "contentType": { "type": "string" },
        "timestamp": { "type": "integer", "minimum": 0 },
        "requestBodyRef": {
          "type": "string",
          "pattern": "^artifact://",
          "description": "默认不采集请求体；需按项目白名单开放后才存在引用"
        },
        "responseBodyRef": {
          "type": "string",
          "pattern": "^artifact://",
          "description": "经过脱敏与大小限制后才允许引用；默认缺省"
        }
      }
    },
    "ConsoleEvent": {
      "title": "ConsoleEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "message"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["log", "info", "warn", "error", "debug"]
        },
        "message": { "type": "string" },
        "location": { "type": "string" },
        "timestamp": { "type": "integer", "minimum": 0 }
      }
    },
    "PageError": {
      "title": "PageError",
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "stack": { "type": "string" },
        "sourceFile": { "type": "string" },
        "loc": { "$ref": "#/$defs/Loc" },
        "timestamp": { "type": "integer", "minimum": 0 }
      }
    },
    "Loc": {
      "title": "Loc",
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "col"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 }
      }
    },
    "Interaction": {
      "title": "Interaction",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["click", "input", "select", "navigate", "submit", "other"]
        },
        "target": {
          "type": "string",
          "description": "目标元素摘要，如 button:has-text('提交') 或 dom 引用"
        },
        "inputType": { "type": "string" },
        "valueSummary": {
          "type": "string",
          "description": "输入值摘要；敏感字段必须脱敏"
        },
        "timestamp": { "type": "integer", "minimum": 0 },
        "triggeredEvents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本次交互引发的 network / navigation 事件 id"
        },
        "screenshotRef": {
          "type": "string",
          "pattern": "^artifact://",
          "description": "交互后的页面截图引用；B 模式每步必拍"
        },
        "result": {
          "type": "string",
          "enum": ["success", "failed", "no_change"],
          "description": "交互执行结果：success 正常完成；failed 执行报错；no_change 页面无可见变化"
        }
      }
    },
    "Correlation": {
      "title": "Correlation",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["matched", "candidate", "unmatched"],
          "description": "matched：证据充分；candidate：多个可能来源待确认；unmatched：当前无法建立关联"
        },
        "domRef": {
          "type": "string",
          "description": "DOM 元素引用，指向 dom_snapshot 中的元素 id"
        },
        "staticNodeId": {
          "type": "string",
          "description": "IR 节点 id；unmatched 时缺省"
        },
        "apiNodeId": {
          "type": "string",
          "description": "网络请求关联到静态 API 节点时使用"
        },
        "networkEventId": {
          "type": "string",
          "description": "网络请求关联时指向 NetworkEvent.eventId"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "关联置信度；不得因名称相同就直接取 1.0"
        },
        "method": {
          "type": "string",
          "enum": ["data-analysis-id", "source-map", "structural", "fiber"],
          "description": "关联依据，按可靠性从高到低"
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "rejected"],
          "default": "pending",
          "description": "人工确认结果；与系统判定的 status 分离，确认后可跨分析复用"
        }
      }
    },
    "Exploration": {
      "title": "Exploration",
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "steps"],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "用户输入的探索目标，如「测试用户登录流程」"
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 15,
          "description": "探索步数上限，防止无限循环"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExplorationStep" },
          "description": "AI 决策并执行的探索步骤序列"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario",
          "description": "AI 根据探索过程归纳的用户场景"
        },
        "testCases": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestCase" },
          "description": "AI 生成的测试用例清单"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "stepIndex"],
            "properties": {
              "ref": { "type": "string", "pattern": "^artifact://" },
              "stepIndex": { "type": "integer", "minimum": 0 },
              "caption": { "type": "string" }
            }
          }
        }
      }
    },
    "ExplorationStep": {
      "title": "ExplorationStep",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "action", "target", "result"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "action": {
          "type": "string",
          "enum": ["click", "input", "select", "navigate", "submit", "hover", "scroll", "other"]
        },
        "target": {
          "type": "string",
          "description": "目标元素的可读描述，如「登录按钮」或 selector 摘要"
        },
        "selector": {
          "type": "string",
          "description": "实际使用的 Playwright selector"
        },
        "valueSummary": {
          "type": "string",
          "description": "input/select 的值摘要；敏感字段脱敏"
        },
        "reasoning": {
          "type": "string",
          "description": "AI 选择该操作的理由（用于审计）"
        },
        "result": {
          "type": "string",
          "enum": ["success", "failed", "no_change"],
          "description": "执行结果"
        },
        "error": {
          "type": "string",
          "description": "result=failed 时的错误信息"
        },
        "screenshotRef": {
          "type": "string",
          "pattern": "^artifact://",
          "description": "本步执行后的截图引用"
        },
        "triggeredNetworkEvents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本步引发的网络事件 id"
        },
        "pageTransitioned": {
          "type": "boolean",
          "description": "本步是否触发了页面跳转/路由变化"
        }
      }
    },
    "Scenario": {
      "title": "Scenario",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "场景前置条件"
        },
        "expectedOutcome": {
          "type": "string",
          "description": "场景预期结果"
        }
      }
    },
    "TestCase": {
      "title": "TestCase",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "steps", "expected"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "priority": {
          "type": "string",
          "enum": ["p0", "p1", "p2", "p3"]
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "测试步骤的自然语言描述"
        },
        "expected": {
          "type": "array",
          "items": { "type": "string" },
          "description": "预期断言"
        },
        "relatedSteps": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "关联的探索步骤 index"
        }
      }
    }
  }
}
