APP_NAME=React 代码智能分析平台
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 需求定位的模型接入。默认关闭：未开启时定位接口仍可用，但只能 dry-run
# （只跑确定性召回，不调用模型）。开启需要同时给 base_url 与 api_key。
# 走 OpenAI 兼容协议，DeepSeek / 通义 / KIMI / Ollama 都填同一组字段。
APP_LLM_ENABLED=false
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_TIMEOUT_SECONDS=60

# 输出 token 上限。太小会把判定 JSON 截断成非法 JSON，反而浪费调用预算。
APP_LLM_MAX_TOKENS=4096
# 用 response_format=json_object 约束模型输出。极少数兼容端点不支持该字段并
# 返回 400，此时设 false 退化为纯 prompt 约束。
APP_LLM_RESPONSE_FORMAT=true
APP_LLM_MAX_CANDIDATES=30
APP_LLM_MAX_CALLS_PER_REQUEST=4

# 持久化。缺省（不配置 APP_DB_URL）→ 内存存储，重启即清空；
# 配置后走 MySQL（要求 8.0+，需求定位 checkpointer 硬性要求 8.0.19+）。
# 驱动 aiomysql 纯 Python，无需本机编译。
# APP_DB_URL=mysql+aiomysql://user:password@127.0.0.1:3306/uicodeanalysis?charset=utf8mb4
# APP_DB_POOL_SIZE=5
# APP_DB_MAX_OVERFLOW=5
# APP_DB_POOL_RECYCLE_SECONDS=1800
